BR2_arm=y
BR2_cortex_a5=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_FPU_NEON=y

# Toolchain: reuse the exact preinstalled Linaro 7.3.1-2018.05 (glibc 2.25)
# toolchain the kernel/U-Boot already build with (linux-arkmicro/env.source),
# NOT BR2_TOOLCHAIN_EXTERNAL_LINARO_ARM (that package pins a different,
# unextracted 7.4.1-2019.02 -- see plan Phase 0 / merry-snacking-wirth.md).
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(BR2_EXTERNAL_ARK_PATH)/../toolchain/gcc-linaro-7.3.1-2018.05-x86_64_arm-linux-gnueabihf"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-linux-gnueabihf"
BR2_TOOLCHAIN_EXTERNAL_GCC_7=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_14=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y

# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ARK_PATH)/board/arkmicro/ark1668-ft/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ARK_PATH)/board/arkmicro/ark1668-ft//post_build.sh"
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_ARK_PATH)/board/arkmicro/ark1668-ft//busybox.config"

BR2_PACKAGE_ALSA_UTILS=y
# BR2_PACKAGE_ALSA_UTILS_ALSACTL is not set
# BR2_PACKAGE_ALSA_UTILS_ALSAMIXER is not set
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_LIB=y

BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_MXML=y
BR2_PACKAGE_NCURSES=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set

# D-Bus: only for the real system dbus-daemon binary/message-bus machinery.
# BlueZ itself is NOT a Buildroot package here -- see merry-snacking-wirth.md's
# 2026-08-21 re-scope note. tools/bluetoothd-test/'s hardware-confirmed static
# bluetoothd 5.66 + dbus-policy files are carried in via the Phase 3 overlay
# instead.
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_EXPAT=y

# WiFi AP (replaces the static hostapd/wpa_supplicant path with dynamic
# Buildroot-built ones)
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBNL=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_TOOLS=y

BR2_PACKAGE_ARK1668FT=y

# host-fakeroot 1.20.2 doesn't compile against a modern host glibc
# (missing _STAT_VER, dropped from public headers ~glibc 2.32+) --
# real error hit building on this dev machine (glibc 2.36). Patch
# lives in buildroot-external/patches/fakeroot/, applied via the
# global patch dir mechanism so it survives dirclean/re-extract.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_ARK_PATH)/patches"

# ext4 rootfs target -- deployment is rsync onto an ext4 SD partition via
# build_bootable_sdcard_custom_ui.sh, not NAND/UBI.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# BR2_TARGET_ROOTFS_TAR is not set
