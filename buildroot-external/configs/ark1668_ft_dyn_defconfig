BR2_arm=y
BR2_cortex_a5=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_FPU_NEON=y

# Toolchain (2026-08-22 migration, see merry-snacking-wirth.md's
# "glibc 2.36 migration" section -- real final result: glibc 2.30,
# GCC 8.4.0). Two real, hard blockers found and worked through in
# sequence, both documented in full in the plan file:
#
# 1. Debian 12's system cross toolchain (glibc 2.36) -- REJECTED.
#    Buildroot's own check_unusable_toolchain (toolchain/helpers.mk)
#    unconditionally refuses any external toolchain reporting
#    `--with-sysroot=/`, which is exactly how Debian's distro cross-gcc
#    is configured. No Kconfig bypass exists.
#
# 2. Bootlin's current stable toolchain (armv7-eabihf--glibc--
#    stable-2024.02-1, GCC 12.3.0/glibc 2.39) -- ALSO REJECTED, a
#    second, different gate: this Buildroot tree (2019.05-rc1) enforces
#    an EXACT gcc-major-version match between the Kconfig selection and
#    the toolchain's real `gcc -dumpversion` (check_gcc_version in the
#    same helpers.mk), and its own Config.in.options tops out at
#    GCC_8 -- there is no 9/10/11/12 choice at all. This Buildroot
#    version's own ceiling, not fixable via toolchain choice alone (a
#    Buildroot-tree upgrade would lift it -- real, available, explicitly
#    OUT OF SCOPE for this pass, see plan file).
#
# Real final choice: Bootlin's older armv7-eabihf--glibc--
# stable-2020.02-1 release -- GCC 8.4.0 (exact match, passes gate 2),
# glibc 2.30 (still a real improvement over the previous 2.25, though
# short of the originally-discussed 2.36/2.39), kernel headers 4.4.215.
# Same provenance/relocatability properties as the 2024.02-1 toolchain
# (built by Buildroot's own toolchain-builder infra, real isolated
# --with-sysroot, passes gate 1 too). Downloaded + relocated
# (relocate-sdk.sh) into buildroot-external/toolchain/
# armv7-eabihf--glibc--stable-2020.02-1/ (gitignored, same convention
# as the other toolchain dirs). Prefix is "arm-buildroot-linux-gnueabihf"
# (Bootlin's own triplet, confirmed via `ls bin/`).
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(BR2_EXTERNAL_ARK_PATH)/toolchain/armv7-eabihf--glibc--stable-2020.02-1"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-buildroot-linux-gnueabihf"
# Exact match required (see note above) -- real toolchain is 8.4.0.
BR2_TOOLCHAIN_EXTERNAL_GCC_8=y
# HEADERS_4_4 matches the real kernel headers baked into this
# toolchain's sysroot exactly (LINUX_VERSION_CODE 263383 = 4.4.215).
BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_4=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# 2026-08-23: real, hardware-confirmed bug -- without this, Buildroot
# never copies the toolchain's own libstdc++.so.6 into the target
# rootfs at all (confirmed absent via `tar -tf` on a real-built
# rootfs.tar -- libgcc_s.so.1 was present, libstdc++.so.6 wasn't).
# custom_ui/androidauto-sidecar are C++ binaries with libstdc++.so.6 in
# their own NEEDED list (confirmed via readelf -d) -- this was a real
# "the file was never deployed at all" gap, not a search-path issue.
# BR2_TOOLCHAIN_EXTERNAL_CXX (real Buildroot Kconfig, toolchain/
# toolchain-external/toolchain-external-custom/Config.in.options)
# selects BR2_INSTALL_LIBSTDCPP, telling Buildroot's toolchain-import
# step this external toolchain has real C++ support and to copy its
# runtime library accordingly. This toolchain (Bootlin GCC 8.4.0) has
# full C++ support -- confirmed, this option was simply never enabled.
BR2_TOOLCHAIN_EXTERNAL_CXX=y

# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ARK_PATH)/board/arkmicro/ark1668-ft/rootfs_overlay $(BR2_EXTERNAL_ARK_PATH)/board/arkmicro/ark1668-ft-dyn/busybox_overlay"
# Forked post_build.sh, NOT the shared board's own -- see plan's
# 2026-08-21 "target-finalize" fix note: the shared one's module-install
# step references a kernel-output path that has never existed in this
# project's real build flow, plus a second bug (TARGET_DIR unbound).
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ARK_PATH)/board/arkmicro/ark1668-ft-dyn/post_build.sh"

# Init/busybox: do NOT let Buildroot build its own bundled busybox for
# this rootfs (user decision, 2026-08-21). This project already has a
# hardware-confirmed static busybox 1.33.0 rebuild (390 applets incl.
# /sbin/init, project memory: HARDWARE-CONFIRMED, build_busybox.sh) --
# CONFIG_STATIC=y, no runtime libc dependency at all, so it's
# ABI-agnostic re: this rootfs going dynamic, same reasoning as the
# bluetoothd/rtk_hciattach reuse above. Carried in verbatim via the new
# busybox_overlay/ dir (real binary + all 396 applet symlinks
# materialized from firmware_overlay/busybox-applets.manifest) rather
# than rebuilt as a Buildroot source package. BR2_INIT_NONE so
# Buildroot doesn't select its own busybox+initscripts pair; this
# rootfs's own /etc/inittab + rcS wiring is a Phase-3 task, not yet
# written -- this build won't fully boot to a working init sequence
# until then, only the busybox-package-swap itself is done here.
BR2_INIT_NONE=y
# BR2_PACKAGE_BUSYBOX is not set

BR2_PACKAGE_ALSA_UTILS=y
# BR2_PACKAGE_ALSA_UTILS_ALSACTL is not set
# BR2_PACKAGE_ALSA_UTILS_ALSAMIXER is not set
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_LIB=y

BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_MXML=y
BR2_PACKAGE_NCURSES=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set

# D-Bus: only for the real system dbus-daemon binary/message-bus machinery.
# BlueZ itself is NOT a Buildroot package here -- see merry-snacking-wirth.md's
# 2026-08-21 re-scope note. tools/bluetoothd-test/'s hardware-confirmed static
# bluetoothd 5.66 + dbus-policy files are carried in via the Phase 3 overlay
# instead.
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_EXPAT=y

# 2026-08-23: real, hardware-confirmed bug -- the hand-carried static
# sshd binary in firmware_overlay_dyn/usr/bin/sshd has the WRONG ELF
# interpreter for this toolchain (/lib/ld-linux.so.3, softfloat, vs
# this project's real /lib/ld-linux-armhf.so.3 hardfloat ABI --
# confirmed via readelf -d/file), so it can never actually run here.
# Build sshd against this project's own current toolchain instead, the
# same fix pattern as BR2_TOOLCHAIN_EXTERNAL_CXX above. Installs to
# usr/sbin/sshd (confirmed via package/openssh/openssh.mk), not
# usr/bin/sshd -- rcS updated to match. The project's own committed
# host keys/sshd_config are reused as-is via `-f`.
BR2_PACKAGE_OPENSSH=y

# WiFi AP (replaces the static hostapd/wpa_supplicant path with dynamic
# Buildroot-built ones)
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBNL=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_TOOLS=y

# tools/ consolidation (2026-08-21) -- prebuilt-binary Buildroot
# packages reusing already hardware-confirmed tools/ artifacts, so
# they build automatically as part of `make` instead of requiring a
# human to remember to build+copy each one by hand. Their files are
# ALSO still present in firmware_overlay_dyn/ from the earlier
# Phase 3 pass (byte-identical, harmless duplication for now, whichever
# lands last wins) -- once these packages are build-verified, remove
# the now-redundant copies from the overlay as a followup, not done
# yet. See merry-snacking-wirth.md's tools/ consolidation section for
# the full disposition list; more of these (nano/htop/tmux/less/
# strace/gdbserver, the ~23 hand-invoked hardware bring-up tools) can
# follow the exact same package pattern later.
BR2_PACKAGE_BLUETOOTHD_TEST=y
BR2_PACKAGE_RTK_HCIATTACH_TEST=y
BR2_PACKAGE_DMESG_TOOL=y

BR2_PACKAGE_ARK1668FT=y

# host-fakeroot 1.20.2 doesn't compile against a modern host glibc
# (missing _STAT_VER, dropped from public headers ~glibc 2.32+) --
# real error hit building on this dev machine (glibc 2.36). Patch
# lives in buildroot-external/patches/fakeroot/, applied via the
# global patch dir mechanism so it survives dirclean/re-extract.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_ARK_PATH)/patches"

# Real version bumps (2026-08-22) for in-tree packages that were
# behind on real fixes -- see buildroot-external/package-overrides.mk
# and merry-snacking-wirth.md's version-currency-audit section for the
# per-package assessment.
BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_ARK_PATH)/package-overrides.mk"

# Rootfs target format: ext4 (Phase 0 decision, 2026-08-21) is the real
# deploy artifact -- deployment is dd/rsync onto an ext4 SD partition
# via build_bootable_sdcard_dyn.sh, not NAND/UBI. This 2019.05-rc1
# Buildroot tree has no standalone BR2_TARGET_ROOTFS_EXT4 symbol --
# ext4 is selected via BR2_TARGET_ROOTFS_EXT2 + BR2_TARGET_ROOTFS_EXT2_4
# (GEN=4), which invokes real mkfs.ext4 and produces both rootfs.ext2
# and a rootfs.ext4 symlink to it (fs/ext2/ext2.mk) -- genuinely an
# ext4 filesystem image, not ext2 despite the Kconfig/output naming.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# 2026-08-23: BR2_TARGET_ROOTFS_TAR enabled alongside the ext4 target
# (not a replacement -- both coexist cleanly, each is an independent
# rootfs-image instantiation with its own private target-dir copy and
# fakeroot pass, confirmed by reading fs/common.mk's inner-rootfs
# macro). build_bootable_sdcard_dyn.sh now extracts rootfs.tar instead
# of rsyncing output/target/ directly -- Buildroot's own official
# per-format target-dir population already excludes the
# THIS_IS_NOT_YOUR_ROOT_FILESYSTEM placeholder, and its fakeroot pass
# (chown -h -R 0:0, mkusers, makedevs -d against the real permission
# table) applies real root:root ownership and permission-table
# entries that a raw output/target/ rsync never got -- a real
# correctness gap the tar path closes, not just a cleaner file list.
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_TAR_NONE=y
