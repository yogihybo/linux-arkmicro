export QTDIR=/usr
export QT_QPA_FONTDIR=$QTDIR/lib/qt/fonts
#export QT_QPA_PLATFORM=linuxfb:fb=/dev/fb0
export QT_QPA_PLATFORM=eglfs
export QT_QPA_EGLFS_INTEGRATION=eglfs_mali
export QT_QPA_EGLFS_DEBUG=0
#export QT_QPA_EGLFS_FORCEVSYNC=1
#export QT_QPA_EGLFS_FORCE888=1
export QT_QPA_PLATFORM_PLUGIN_PATH=$QTDIR/lib/qt/plugins
export QT_QPA_GENERIC_PLUGINS=evdevtouch:/dev/input/event0
export LD_LIBRARY_PATH=$QTDIR/lib:$LD_LIBRARY_PATH
export MALI_NOCLEAR=1
export MALI_MAX_WINDOW_BUFFERS=3
#export QT_QWS_FONTDIR=/usr/lib/fonts
#export QML2_IMPORT_PATH="/usr/qml"
start() {
	export XDG_RUNTIME_DIR=/usr/lib/
	export RUNLEVEL=3
	eval `dbus-launch --auto-syntax`
	FILE=/data/processType
	if [ -f "$FILE" ]; then
		echo "$FILE exist"
	else
		touch  /data/processType
		echo b > /data/processType
	fi
	type=$(cat /data/processType)
	echo "$type"
	echo "$dashBoardType"
	echo "$launcherType"
	if [ "$type" == "a" ]; then
		DashBoard &
	fi

	if [ "$type" == "b" ]; then
		chmod 777 /usr/bin/carlink
		carlink &
		chmod 777 /usr/bin/Launcher
		Launcher &
		chmod 777 /usr/bin/blueware
		blueware /etc/bluetooth/blueware.properties > /dev/null &
	fi
}

stop() {
	echo "stop"
}

restart() {
	stop
	sleep 1
	start
}

case "$1" in
	start|stop|restart)
		"$1";;
	reload)
		# Restart, since there is no true "reload" feature.
		restart;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
esac
