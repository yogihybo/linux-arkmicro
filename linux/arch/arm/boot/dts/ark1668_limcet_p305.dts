// SPDX-License-Identifier: GPL-2.0
/dts-v1/;
#include "ark1668.dtsi"
#include "ark1668-pinctrl.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Limcet P305/P306 Dashboard Head Unit";
	compatible = "arkmicro,ark1668-limcet", "arkmicro,ark1668";

	memory {
		reg = <0x0 0x8000000>; // 128MB RAM
	};

	// Reversing signal detection -- NOT a SoC GPIO on this product, and
	// the carback node above (removed 2026-07-17) never should have had
	// one. docs/HARDWARE_AND_SOC_REFERENCE.md §7 traced this to ground:
	// the real kernel's `carback` platform_device has an all-zero
	// platform_data struct (no GPIO baked in), and MsnCoreApp's active
	// MCU adapter for this product (MCUAdapter_BoxP300, McuType=6) never
	// touches GPIOOperater for it -- reverse-gear detection happens
	// entirely on the companion STM32F105 MCU (wired directly to the
	// vehicle's reverse-light circuit, confirmed by physical board
	// inspection too), which just sends a `backcar enable/disable`
	// command to the SoC over the existing HS-UART arktool link
	// (mcu_serial below). Its former detect-gpios (&gpio0 5) was
	// pinctrl pin 5 = LCD r3 on real hardware -- a silent conflict with
	// the display, for a GPIO that was never real in the first place.

	// ARK1680 on-SoC resistive ADC touchscreen — this is the touch path
	// this unit's stock firmware actually selects (see
	// docs/boot_experiment_log.md "ROOT CAUSE FOUND" and
	// docs/ARK1680_TS_REVERSE_ENGINEERING.md), not the GT911 node below.
	tsc: tsc@e4500000 {
		compatible = "arkmicro,ark1680-ts";
		reg = <0xe4500000 0x40>;
		interrupt-parent = <&vicl>;
		interrupts = <4>;
	};

	mcu_serial: mcu-serial@0 {
		compatible = "arkmicro,ark-mcu-serial";
	};

	tool_serial: tool-serial@0 {
		compatible = "arkmicro,ark-tool-serial";
	};

	// Bit-banged I2C Bus 0 (Analog I2C)
	i2c-gpio-0 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "i2c-gpio";
		gpios = <&gpio0 3 0		/* SDA (GPIO 3) */
			 &gpio0 2 0		/* SCL (GPIO 2) */
		>;
		i2c-gpio,delay-us = <6>;
		i2c-gpio,scl-output-only;

		// Richwave RN6752 AHD Camera Decoder
		dvr_rn6752: dvr_rn6752@2c {
			compatible = "arkmicro,ark1668_rn6752";
			reg = <0x2c>;
			reset-gpio = <&gpio0 0 0>;
			carback-config = <1>;
		};

		// Goodix GT911 Touchscreen Controller -- disabled (2026-07-17).
		// This unit's real touch path is the ARK1680 on-SoC resistive
		// controller (tsc@e4500000 above), not this node -- already
		// documented there. A full pin audit against real stock
		// hardware confirmed it further: every one of this node's four
		// GPIO/pin assignments lands on a pin something else genuinely
		// owns on real hardware -- irq-gpios (&gpio0 4) is pinctrl pin
		// 4 = LCD r2, reset-gpios (&gpio2 16) is pinctrl pin 80 =
		// pwm-2, and its I2C bus (i2c-gpio-0 below) sits on LCD r0/r1.
		// Not "slightly wrong wiring" -- a node with zero legitimate
		// pins on this board, almost certainly carried over unmodified
		// from a different board variant. Left in place but disabled
		// rather than deleted, in case pins are ever confirmed for a
		// real capacitive-touch variant of this board.
		gt911: touchscreen@5d {
			compatible = "goodix,gt911";
			reg = <0x5d>;
			interrupt-parent = <&gpio0>;
			interrupts = <4 IRQ_TYPE_EDGE_FALLING>;
			irq-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
			reset-gpios = <&gpio2 16 GPIO_ACTIVE_HIGH>;
			touchscreen-inverted-x;
			status = "disabled";
		};

	};

	// Bit-banged I2C Bus 1
	i2c-gpio-1 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "i2c-gpio";
		gpios = <&gpio0 9 0		/* SDA (GPIO 9) */
			 &gpio3 25 0		/* SCL (GPIO 121) */
		>;
		i2c-gpio,delay-us = <6>;
		i2c-gpio,scl-output-only;

		// ROHM BD37033FV Sound Processor. Moved back here from
		// i2c-gpio-0 (2026-07-13) after getting a live root shell on
		// real stock hardware (via the msn_autocopy telnetd payload)
		// and running i2c-scan directly against stock's own
		// /dev/i2c-*: /sys/bus/i2c/devices/2-0041 shows a kernel
		// i2c_client bound on stock's i2c-gpio2 -- i.e. exactly these
		// SDA=GPIO9/SCL=GPIO121 pins, not i2c-gpio-0/GPIO2-3 where an
		// earlier session moved it based on a misread of i2c-scan's
		// XX marker (XX only means a driver is bound, not that the
		// device answers -- see docs/I2C_GPIO0_LCD_PIN_CONFLICT.md).
		// Bus placement confirmed correct via that path. CONFIG_SND_
		// SOC_BD37033_NOP must stay OFF, this is real, addressable
		// hardware.
		//
		// Address corrected 0x41 -> 0x40 (2026-07-14). The 0x41 value
		// came only from disassembling stock's *kernel* board file's
		// i2c_board_info struct + the i2c-scan XX marker above --
		// both just prove a kernel i2c_client got registered at that
		// address, not that the chip answers there (same class of
		// mistake the XX-marker note above already flags for other
		// devices). Ground truth is what the vendor's own shipped
		// userspace audio-control code actually uses at runtime:
		// disassembly of libMsnSound.so's Sound_BD37033::Sound_BD37033()
		// constructor shows `I2COperator(bus=2, addr=0x80)`, and
		// libMsnCommons.so's arki2c_open() does `ioctl(fd, I2C_SLAVE,
		// addr >> 1)` -- i.e. the real wire address is 0x80 >> 1 =
		// 0x40, matching the BD37033 datasheet's public 7-bit address.
		// This also fully explains the persistent bd37033_write_byte
		// timeout seen throughout this investigation (including on
		// stock's own kernel dmesg, see docs/I2C_GPIO0_LCD_PIN_CONFLICT.md):
		// stock's *kernel-level* i2c_client was always misaddressed
		// too, its writes just never mattered because stock's real
		// control path bypasses the kernel driver entirely via direct
		// /dev/i2c-2 ioctls at the correct address. Not yet hardware-
		// retested with this fix.
		amp: drv_bd37033@40 {
			status = "okay";
			compatible = "arkmicro,drv_bd37033";
			reg = <0x40>;
			flout-gain = <65>;
			frout-gain = <65>;
			rlout-gain = <65>;
			rrout-gain = <65>;
			#sound-dai-cells = <0>;
		};
	};

	// External Cirrus Logic CS4334 I2S DAC. Stock's own board file binds
	// this as a second dai-link ("cs4334 <-> ark_i2s_dev.1 mapping ok" in
	// docs/logs/dmesg live device kernel 3.4 dmeg.txt) but it never
	// produces a usable PCM device -- live `aplay -l` on stock hardware
	// (docs/logs/audio log stock.txt) shows exactly ONE playback device,
	// "card 0: ARKSDDAC [ARK-SDDAC], device 0: SDDAC sddac-hifi-0" --
	// i.e. stock's actual, working playback path is the INTERNAL SDDAC
	// (ark_i2s_dev.0), not CS4334. The 2026-07-16 pivot to CS4334 as the
	// primary playback dai-link (based on the KERNEL_REFERENCE.md module
	// table + that "mapping ok" line alone) was the wrong turn -- same
	// class of mistake as trusting an I2C "XX" marker or a DAI mapping
	// line as proof of a *working* path rather than just a *registered*
	// one (feedback_bootlog_evidence_weak). Reverted below; this node
	// kept (unreferenced) since it's harmless and stock's own driver
	// graph still includes it, even though it's a dead end for audio.
	cs4334_codec: cs4334-codec {
		compatible = "arkmicro,ark1668e_cs4334_codec";
		#sound-dai-cells = <0>;
	};

	// Audio Card configuration
	sound {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		// Matches stock's card name exactly (soc-audio.0 machine driver,
		// "ASoC machine ARK-SDDAC" in dmesg / "card 0: ARKSDDAC
		// [ARK-SDDAC]" in aplay -l) -- purely cosmetic/diagnostic parity,
		// not required for function.
		simple-audio-card,name = "ARK-SDDAC";

		// BD37033 (&amp) is control-only from this card's point of view --
		// no I2S DAI stream of its own, just I2C-driven mixer controls
		// ("PA Volume" etc, see sound/soc/arkmicro/BD37033.c). Without
		// listing it as an aux-dev, devm_snd_soc_register_component()
		// still registers the component driver (see bd37033_drv_probe),
		// but its controls are only ever added to a card's kcontrol list
		// when the component is bound into that card -- which never
		// happened here, since no dai-link below references &amp. That's
		// why "PA Volume"/"PA Mute" never appeared in `amixer scontrols`
		// even on boots where the I2S data path and I2C bus were both
		// fine (2026-07-14, see docs/AUDIO_SUBSYSTEM_INVESTIGATION.md).
		simple-audio-card,aux-devs = <&amp>;

		// DAC/playback link listed FIRST (2026-07-13) so it lands on
		// PCM device 0, matching /etc/asound.conf's hardcoded
		// dmix slave "hw:0,0" -- simple-audio-card assigns device
		// numbers by dai-link order, and with ADC first the playback
		// device landed on hw:0,1 instead, causing every dmix/softvol
		// PCM to fail with "unable to open slave" at MsnCoreApp
		// startup (see docs/AUDIO_SUBSYSTEM_INVESTIGATION.md). Only
		// the DTS order changed here; asound.conf is untouched
		// (shared with stock, which the reg errors elsewhere suggest
		// expects device 0 to be playback).
		simple-audio-card,dai-link@0 { /* I2S DAC link -- internal SDDAC, stock's real playback path */
			simple-audio-card,stream-name = "sddac-hifi";
			bitclock-master = <&playback_cpu>;
			frame-master = <&playback_cpu>;
			playback_cpu: cpu {
				sound-dai = <&i2s_dac>;
			};
			playback_codec: codec {
				sound-dai = <&sddac>;
			};
		};
		simple-audio-card,dai-link@1 { /* I2S ADC link */
			cpu {
				sound-dai = <&i2s_adc>;
			};
			codec {
				sound-dai = <&sdadc>;
			};
		};
	};
};

&usb0_phy {
	compatible = "usb-nop-xceiv";
	#phy-cells = <0>;
	status = "okay";
};

&usb1_phy {
	compatible = "usb-nop-xceiv";
	#phy-cells = <0>;
	status = "okay";
};

&usb0 {
	status = "okay";
};

&usb1 {
	/* interrupts = <40>, <39> (added 2026-07-16, bundled into an
	 * unrelated I2S commit with no explanation) was wrong -- vich
	 * (arch/arm/boot/dts/ark1668.dtsi's interrupt-parent for this node)
	 * is a single arm,pl192-vic with only 32 lines (#interrupt-cells=1,
	 * valid range 0-31). 40 and 39 are out of range for that domain.
	 * 40-32=8 and 39-32=7 exactly match ark1668.dtsi's original values
	 * for this node -- this override looks like a global/SoC-wide
	 * interrupt-numbering reference (where vich's lines might be
	 * documented as a conceptual 32-63) mistakenly used as the raw,
	 * VIC-local interrupt number this property actually needs. This is
	 * the direct cause of "musb-ark e0400000.usb: Failed to get irq" /
	 * "probe of e0400000.usb failed with error -22", seen in every
	 * single boot log since this override was added -- confirmed the
	 * onboard WiFi module and the external-facing USB port are on
	 * separate physical controllers (usb0/usb1), and this is why they
	 * couldn't work at the same time: usb1 never successfully probed at
	 * all. Dropping the override restores the known-good base values. */
	status = "okay";
};

// Console debug UART
&uart0 {
	use-in-kernel;
	use-for-tool;
};

&uart1 {
	status = "disabled";
};

// High-speed MCU Communication UART
&uart3 {
	use-in-kernel;
	use-for-mcu;
};

// LCD Framebuffer Configuration
//
// pinctrl-0 reverted to the stock full pinctrl_lcd_rgb888 group
// (2026-07-17). A previous commit (cce2b32e7) swapped this for a custom
// pinctrl_lcd_prado group that dropped r0, r1, and r7 -- 3 of the 8
// red-channel pins, including the MSB -- to free GPIO 2/3/9 for
// i2c-gpio-0/i2c-gpio-1 bit-banging. That justification cited a doc
// (docs/I2C_GPIO0_LCD_PIN_CONFLICT.md) that was never actually created
// -- the pin choice was never validated against real board wiring, it
// was just assumed from the DTS file's first commit onward. Losing the
// red MSB while green/blue stayed full 8-bit produced visible red
// banding/overlay on real hardware. Since the framebuffer is still
// programmed as 32bpp/RGB888 (bits-per-pixel below), the LCD controller
// was never told to actually run at a reduced depth either -- pins were
// just silently dropped from pinctrl while the peripheral kept shifting
// out a full 24-bit-wide signal.
//
// This also very likely explains the chronic i2c-gpio-0/i2c-gpio-1
// unreliability seen throughout this project (Goodix-TS i2c failures,
// bd37033 i2c_transfer timeouts on every boot) -- those buses share
// GPIO 2/3/9 with the LCD's red channel, so the LCD controller actively
// toggling those pins as pixel timing and the kernel bit-banging I2C on
// them at the same time would corrupt both. The SoC has a real, separate
// hardware I2C controller (i2c0 @ 0xe4300000, pinctrl_i2c0 on
// ARK_PBANK_2 pins 6/7, see ark1668-pinctrl.dtsi) that doesn't touch any
// LCD pin -- moving GT911/RN6752/BD37033 onto it is a promising follow-up
// but needs an i2c-scan on hardware first to confirm those devices are
// actually wired to i2c0's pins before committing to it.
&lcdc {
	display = <&display0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lcd_base &pinctrl_lcd_rgb888>;

	display0: display@0 {
		interface-type = "TTL";
		lvds-con = <0x160fd>;
		bits-per-pixel = <32>;
		power-control-gpio = <&gpio2 17 GPIO_ACTIVE_HIGH>; /* LCD power enable pin (GPIO 81) */
		lcd-wiring-mode = "BGR";
		lcdcon-backlight;
		pwms = <&pwm0 1 50000>; /* Backlight PWM Channel 1 */
		pwm-names = "backlight";
		backlight-value = <20>;
		backlight-delay = <200>;

		display-timings {
			native-mode = <&timing0>;
			timing0: timing0 {
				/* Was guessed/wrong -- corrected 2026-07-18 to match
				 * Prado's own real, dumped panel timing exactly:
				 * firmware_source/prado_reconstructed/mtd4_arkdata/
				 * arkdata.ini, [LCD_TIMMING]/[LCD_CLOCK] for
				 * ScreenId=0 (the authoritative Stage-1 timing
				 * source, see docs/DISPLAY_SUBSYSTEM.md). hfront-porch
				 * was 210 here vs the real HFP=25 -- 8x too large --
				 * and every other porch/sync-length value was also
				 * off by a large margin. Wrong back-porch/sync-length
				 * shifts where the active video window starts
				 * relative to the sync pulses, which is exactly what
				 * produces a visibly offset image. clock-frequency
				 * corrected to CLKFreq/CLKDIV1 = 330000000/11 =
				 * 30000000 (was 33000000). Sync polarities
				 * (hsync-active/vsync-active/de-active) were already
				 * correct, matching IHS=1/IVS=1/IOE=0 in the same
				 * arkdata.ini block -- left unchanged. */
				clock-frequency = <30000000>;
				hactive = <800>;
				vactive = <480>;
				hback-porch = <32>;
				hfront-porch = <25>;
				vback-porch = <29>;
				vfront-porch = <25>;
				hsync-len = <54>;
				vsync-len = <16>;
				hsync-active = <1>;
				vsync-active = <1>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};
	};
};

&vdec0 {
	status = "okay";
};

// nand-on-flash-bbt (set in ark1668.dtsi) makes the kernel cache its own
// bad-block table to a reserved flash area and trust it on every later
// boot instead of rescanning -- stock's own driver never does this (it
// always rescans real factory OOB markers at boot instead of trusting a
// persisted cache), and a boot where this driver's ECC config couldn't
// correctly decode the existing cache didn't just fail to read it, it
// silently rescanned AND wrote a fresh, wrong table back to physical
// flash -- confirmed happening for real, reproducing the historical
// "417 false bad blocks" bug exactly (see
// prado-firmware-reconstruction's
// docs/historical/HANDOFF_nand_ecc_uboot_vs_kernel.md section 1's
// follow-up). Dropping the property here disables flash-based BBT
// caching entirely for this board -- every boot always does a fresh
// factory-marker scan, kept in RAM only, matching stock's own
// self-healing behavior and never persisting anything to flash again.
&nfc {
	/delete-property/ nand-on-flash-bbt;
};

// SDIO WiFi Controller
&mmc1 {
	status = "okay";
	non-removable;
	broken-cd;
};

&gpu {
	compatible = "arkmicro,vivante-hal", "fsl,imx6q-gpu";
	reg-names = "iobase_3d";
	interrupt-names = "irq_3d";
	clocks = <&gpuclk>, <&gpuclk>, <&gpuclk>, <&gpuclk>, <&gpuclk>, <&gpuclk>;
	clock-names = "gpu3d_clk", "gpu3d_axi_clk", "gpu3d_shader_clk", "gpu2d_clk", "gpu2d_axi_clk", "openvg_axi_clk";
	status = "okay";
};

// DIAGNOSTIC: enabled with no child devices so both this controller and
// i2c-gpio-0 (which still owns the gt911@5d + dvr_rn6752@2c nodes above) are
// live simultaneously. Lets a userspace i2c scan on /dev/i2c-* determine,
// empirically, which physical bus the GT911 actually ACKs on — see
// docs/boot_experiment_log.md "Systematic I2C bus verification" and
// tools/i2c-scan/. Do not attach gt911 here until that scan confirms it.
&i2c0 {
	status = "okay";
	clock-frequency = <100000>;
};

// gpio0's full 0-31 range restored (2026-07-17, reverting an earlier
// change from later the same day). docs/HARDWARE_AND_SOC_REFERENCE.md's
// static disassembly of the real stock 3.4 kernel's own board file (zero
// live-hardware risk, not a guess) confirms pins 2/3 (i2c-gpio-0, RN6752
// reversing-camera decoder) and pin 9 (i2c-gpio-1 SDA, BD37033 sound amp)
// are a DELIBERATE, vendor-accepted pin-share with LCD r0/r1/r7 on real
// hardware -- not a wiring mistake. Stock's own firmware has the exact
// same rn6752_eq_work-reset retry loop and BD37033 write-timeout log
// lines seen in every one of this project's own boot logs; those are
// stock's known, accepted quirk from this sharing, not bugs introduced
// here. Restricting this range (as briefly tried earlier the same day)
// would stop RN6752/BD37033 from probing at all -- a real regression
// versus matching stock, not a fix. What *was* a genuine bug is separate:
// the old pinctrl_lcd_prado override (removed earlier, see &lcdc below)
// permanently/statically dropped r0/r1/r7 from the LCD's own pinctrl-0
// claim, unlike stock which keeps the full RGB888 group continuously
// claimed and only briefly steals these specific pads for GPIO duty
// during actual i2c-gpio bit-bang activity.
&gpio0 {
	gpio-ranges = <&pinctrl0 0 0 32>;
};
