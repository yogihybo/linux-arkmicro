/dts-v1/;
#include "arkn141.dtsi"
#include "arkn141-pinctrl.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	sound {
		//compatible = "arkmicro,arkn141-audio";
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,name = "arkn141-audio";
		#address-cells = <1>;
		#size-cells = <0>;

		simple-audio-card,dai-link@0 {		/* I2S - dac */
			reg = <0>;
			cpu {
				sound-dai = <&i2s_dac>;
			};
			codec {
				sound-dai = <&sddac>;
			};
		};

		simple-audio-card,dai-link@1 {		/* I2S - adc */
			reg = <1>;
			format = "i2s";
			cpu {
				sound-dai = <&i2s_adc>;
			};
			codec {
				sound-dai = <&sdadc>;
			};
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* global autoconfigured region for contiguous allocations */
		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x3800000>;
			linux,cma-default;
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		key0 {
			label = "PB_LOCK";
			gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;
			linux,code = <0x100>;
			debounce-interval = <20>;
		};

		key1 {
			label = "PB_POWER";
			gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
			linux,code = <0x101>;
			debounce-interval = <20>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led0 {
			label = "red";
			gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;
		};

		led1 {
			label = "blue";
			gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "timer";
			default-state = "on";
		};
	};

	adc {
		compatible = "arkmicro,arkn141-adc";
		reg = <0x40403000 0x1000
			0x40408000 0x1000>;
		interrupt-parent = <&intc>;
		interrupts = <0x10>;
	};

	i2c-gpio-0 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "i2c-gpio";
		gpios = <&gpio3 6 0		/* SDA */
			&gpio3 5 0		/* SCL */
		>;
		i2c-gpio,delay-us = <2>;	/* clk freq = 500/delay KHz */
		i2c-gpio,scl-output-only;
		//i2c-gpio,sda-open-drain;
		//i2c-gpio,scl-open-drain;

		da380: da380@4e {
			compatible = "arkmicro,da380";
			gpios = <&gpio3 11 0>;
			reg = <0x27>; /* i2c address(7 bits) */
		};
	};
};

&i2c0 {
	sensor0: gc2053@37 {
		compatible = "arkmicro,gc2053";
		reg = <0x37>;
		sensor-fps = <30>;
	};

	sensor1: imx322@1a {
		compatible = "arkmicro,imx322";
		reg = <0x1a>;
		sensor-fps = <30>;
		status = "disabled";
	};
};

&ecspi {
	m25p80@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "mx25l12805d";
		reg = <0>; /* Chip select 0 */
		spi-max-frequency = <50000000>;
	};
};
