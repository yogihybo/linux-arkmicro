# RTC support -- the device tree already declares the real hardware
# (rtc@40406000, compatible "arkmicro,ark-rtc") and drivers/rtc/rtc-ark.c
# already exists, but RTC_CLASS was never enabled, so the whole RTC
# subsystem was compiled out entirely -- no /dev/rtc0 ever appeared,
