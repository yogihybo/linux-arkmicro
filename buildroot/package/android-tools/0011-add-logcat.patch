diff -urpN android-tools-4.2.2+git20130218/core/include/logwrap/logwrap.h b/core/include/logwrap/logwrap.h
--- android-tools-4.2.2+git20130218/core/include/logwrap/logwrap.h	1970-01-01 08:00:00.000000000 +0800
+++ b/core/include/logwrap/logwrap.h	2021-12-30 16:02:21.396306000 +0800
@@ -0,0 +1,87 @@
+/* system/core/include/logwrap/logwrap.h
